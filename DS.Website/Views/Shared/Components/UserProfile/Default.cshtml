@model DS.Website.Components.UserProfileViewModel

<div class="buttons">
    @if (Model.IsLoggedIn) {
        <div class="dropdown is-right is-hoverable">
            <div class="dropdown-trigger">
                <button class="button" aria-haspopup="true" aria-controls="user-profile-menu">
                    <span>@Model.Name</span>
                    <span class="icon is-small"><i class="fas fa-angle-down"></i></span>
                </button>
            </div>
            <div class="dropdown-menu" id="user-profile-menu" role="menu">
                <div class="dropdown-content">
                    <div class="dropdown-item">
                        <p class="is-size-7 has-text-grey mb-2">Grupper</p>
                        <div class="tags">
                            @if (Model.Groups.Any())
                            {
                                foreach (var group in Model.Groups)
                                {
                                    <span class="tag is-info is-light">@group</span>
                                }
                            }
                            else
                            {
                                <span class="tag is-warning is-light">Ingen grupper</span>
                            }
                        </div>
                    </div>
                    <hr class="dropdown-divider" />
                    <div class="dropdown-item">
                        <a href="/profile">
                            <span class="icon is-small mr-1"><i class="fas fa-user"></i></span>
                            Min profil
                        </a>
                    </div>
                    <div class="dropdown-item">
                        <form asp-action="Logout" asp-controller="Account" method="get">
                            @Html.AntiForgeryToken()
                            <button class="button is-danger is-light is-fullwidth" type="submit">
                                <span class="icon"><i class="fas fa-door-open"></i></span>
                                <span>Log ud</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else {
        <a asp-action="Login" asp-controller="Account" class="button is-primary">Log ind</a>
    }
</div>