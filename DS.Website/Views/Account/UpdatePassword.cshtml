@model ChangePasswordInputModel

<section class="section">
    <div class="columns is-centered">
        <div class="column is-5-desktop is-7-tablet">

            <div class="box">
                <h1 class="title has-text-centered">Skift adgangskode</h1>

                @if (ViewData["PasswordChanged"] is true)
                {
                    <div class="notification is-success is-light">
                        Din adgangskode er blevet opdateret.
                    </div>
                }

                <form asp-action="UpdatePassword" asp-controller="Account" method="post">

                    <div class="field">
                        <label asp-for="OldPassword" class="label">Nuværende adgangskode</label>
                        <div class="control has-icons-left">
                            <input asp-for="OldPassword" class="input" placeholder="••••••••" />
                            <span class="icon is-small is-left">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                        <span asp-validation-for="OldPassword" class="help is-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="NewPassword" class="label">Ny adgangskode</label>
                        <div class="control has-icons-left">
                            <input asp-for="NewPassword" class="input" placeholder="••••••••" />
                            <span class="icon is-small is-left">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                        <span asp-validation-for="NewPassword" class="help is-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="RepeatNewPassword" class="label">Gentag ny adgangskode</label>
                        <div class="control has-icons-left">
                            <input asp-for="RepeatNewPassword" class="input" placeholder="••••••••" />
                            <span class="icon is-small is-left">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                        <span asp-validation-for="RepeatNewPassword" class="help is-danger"></span>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="notification is-danger is-light py-2 px-4 my-3"></div>

                    <div class="field mt-5">
                        <button type="submit" class="button is-primary is-fullwidth">
                            <span class="icon">
                                <i class="fas fa-key"></i>
                            </span>
                            <span>Opdater adgangskode</span>
                        </button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</section>
