@model RegisterInputModel

<section class="section">
    <div class="columns is-centered">
        <div class="column is-5-desktop is-7-tablet">
            
            <div class="box">
                <h1 class="title has-text-centered">Opret bruger</h1>
                
                <form asp-action="Register" asp-controller="Account" method="post">
                    
                    <div class="columns">
                        <div class="column">
                            <div class="field">
                                <label asp-for="FirstName" class="label">Fornavn</label>
                                <div class="control">
                                    <input asp-for="FirstName" class="input" placeholder="Jensen" />
                                </div>
                                <span asp-validation-for="FirstName" class="help is-danger"></span>
                            </div>
                        </div>
                        
                        <div class="column">
                            <div class="field">
                                <label asp-for="LastName" class="label">Efternavn</label>
                                <div class="control">
                                    <input asp-for="LastName" class="input" placeholder="Hansen" />
                                </div>
                                <span asp-validation-for="LastName" class="help is-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="field">
                        <label asp-for="Email" class="label">Email</label>
                        <div class="control has-icons-left">
                            <input asp-for="Email" class="input" placeholder="navn@domæne.dk" />
                            <span class="icon is-small is-left">
                                <i class="fas fa-envelope"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Email" class="help is-danger"></span>
                    </div>
                    
                    <div class="field">
                        <label asp-for="Password" class="label">Adgangskode</label>
                        <div class="control has-icons-left">
                            <input asp-for="Password" class="input" placeholder="••••••••" />
                            <span class="icon is-small is-left">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Password" class="help is-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="RepeatPassword" class="label">Gentag adgangskode</label>
                        <div class="control has-icons-left">
                            <input asp-for="RepeatPassword" class="input" placeholder="••••••••" />
                            <span class="icon is-small is-left">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                        <span asp-validation-for="RepeatPassword" class="help is-danger"></span>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="notification is-danger is-light py-2 px-4 my-3"></div>

                    <div class="field mt-5">
                        <button type="submit" class="button is-primary is-fullwidth">
                            <span class="icon">
                                <i class="fas fa-user-plus"></i>
                            </span>
                            <span>Opret bruger</span>
                        </button>
                    </div>
                    
                </form>
            </div>
            
        </div>
    </div>
</section>