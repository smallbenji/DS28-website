@model User

<section class="hero is-primary">
    <div class="hero-body">
        <p class="title">@Model.GetFullName()</p>
        <p class="subtitle">@Model.Id</p>
    </div>
</section>

<section class="section">
    <nav class="panel">
        <p class="panel-heading">
            Metadata
        </p>
        <div class="panel-block px-4 py-4 d-block">
            
            <form method="post" asp-action="Details" >
                <input type="hidden" asp-for="Id" />

                <div class="field">
                    <label class="label" asp-for="GroupNumber">Gruppenummer</label>
                    <div class="control">
                        <input class="input" asp-for="GroupNumber" placeholder="Indtast gruppenummer..." />
                    </div>
                </div>

                <div class="field mt-4">
                    <div class="control">
                        <button type="submit" class="button is-link">Gem ændringer</button>
                    </div>
                </div>
            </form>
            
        </div>
    </nav>
</section>