@using DS.Models
@model List<Activity>

<table class="table is-fullwidth is-striped">
    <thead>
        <tr>
            <th>Navn</th>
            <th>Oprettet den</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var activity in Model)
        {
            <tr>
                <td>@activity.Name</td>
                <td></td>
            </tr>
        }
    </tbody>
</table>