@using DS.Website.Controllers
@model HomeViewModel
<!-- FORMULAR TIL AT OPRETTE -->
<form hx-post="/activities/create-simple" 
      hx-target="#activity-list" 
      hx-swap="innerHTML"
      hx-on::after-request="if(event.detail.successful) this.reset();">
    
    <div class="field">
        <label class="label">Aktivitetsnavn</label>
        <input class="input" type="text" name="name" placeholder="F.eks. Sommerlejr transport" required />
    </div>
    
    <button type="submit" class="button is-primary">Opret og opdater liste</button>
</form>

<hr />

<!-- CONTAINER TIL LISTEN -->
<h3 class="title is-4">Aktiviteter</h3>
<div id="activity-list">
    <!-- Vi indlæser den eksisterende liste med det samme ved første besøg -->
    @await Html.PartialAsync("_ActivityList", Model.Activities)
</div>