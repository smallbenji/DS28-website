@using DS.Website.Controllers
@model HomeViewModel

<div class="grid">
    @foreach (var obj in Model.Shortcuts)
    {
        <a href="@obj.URL" class="link-box">
            <div>
                <i class="@obj.Icon"></i>
                <p>@obj.Title</p>
            </div>
        </a>
    }
</div>