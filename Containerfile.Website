FROM docker.io/library/node:24 AS node-build

WORKDIR /src/DS.Frontend
COPY src/DS.Frontend/package*.json ./
RUN npm ci
COPY src/DS.Frontend/. .
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/ .
COPY --from=node-build /src/DS.Backend/wwwroot/dist /src/DS.Backend/wwwroot/dist
RUN dotnet restore DS.Backend/DS.Backend.csproj
RUN dotnet publish DS.Backend/DS.Backend.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
ENTRYPOINT ["dotnet", "DS.Backend.dll"]
COPY --from=build /app/publish ./